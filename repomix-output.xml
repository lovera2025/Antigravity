              // En widescreen, el panel de ingresados flota a un lado
              if (isWidescreen)
                Positioned(
                  top: 80,
                  right: 40,
                  bottom: 40,
                  width: constraints.maxWidth * 0.3,
                  child: _buildIngresadosPanel(),
                ),
                
              if (_current != null) _buildWelcomeCard(constraints),
              _buildHandshakeOverlay(), 
