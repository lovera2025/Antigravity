                  final dx = 0.15 + 0.7 * ((i % 4) / 4) + 0.18 * cos(phase);
                  final dy = 0.2 + 0.6 * ((i % 5) / 5) + 0.18 * sin(phase);
                  final size = 8.0 + 22.0 * (0.5 + 0.5 * sin(phase));
                  final color = HSVColor.fromAHSV(
                    1,
                    (180 + i * 25 + t * 200) % 360,
