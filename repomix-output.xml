                        color: _gold,
                      ),
                    ),
                    const SizedBox(height: 40),
                    Text(
                      'ESTABLECIENDO CONEXIÓN'.toUpperCase(),
                      style: GoogleFonts.oswald(
                        fontSize: 12,
                        fontWeight: FontWeight.w800,
                        letterSpacing: 4,
                        color: _gold.withValues(alpha: 0.6),
                      ),
                    ),
                    const SizedBox(height: 10),
