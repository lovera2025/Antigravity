      context: context,
      builder: (ctx) => AlertDialog(
        title: Text('DEFINIR DETALLES: ${servicio.nombre.toUpperCase()}'),
        content: SizedBox(
          width: 450, // Ancho fijo para forzar el wrapping del texto
