                        120 * sin(t * (0.5 + i * 0.17) * 2 * pi),
                    top: (0.15 + 0.7 * ((5 - i) / 6)) * MediaQuery.of(context).size.height +
                        80 * cos(t * (0.4 + i * 0.13) * 2 * pi),
