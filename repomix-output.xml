  static Future<void> _onUpgrade(Database db, int oldVersion, int newVersion) async {
    debugPrint('🔄 Migrando SQLite de v$oldVersion a v$newVersion...');
    if (oldVersion < 2) {
      debugPrint('  🔧 Aplicando migración v2...');
      
