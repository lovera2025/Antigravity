                ),

              ],
            ),
          ),
        ],
      ),
    );
  }


  Widget _buildPanelFooter() {
    return Container(
      padding: const EdgeInsets.all(24),
      decoration: BoxDecoration(
        color: Colors.black.withValues(alpha: 0.3),
        border: Border(top: BorderSide(color: Colors.white.withValues(alpha: 0.05))),
