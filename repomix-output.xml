                    const SizedBox(width: 8),
                    Expanded(
                      child: TextField(
                        controller: mesaCuotasCtrl,
                        keyboardType: TextInputType.number,
                        decoration: const InputDecoration(labelText: 'Cuotas Mesa (Total)', border: OutlineInputBorder()),
