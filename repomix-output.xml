            child: InkWell(
              onTap: widget.onTap,
              borderRadius: BorderRadius.circular(24),
              child: Row(
                children: [
                // Avatar Minimalista
                Container(
                  width: 52,
                  height: 52,
                  decoration: BoxDecoration(
                    gradient: LinearGradient(
                      colors: [widget.gold.withValues(alpha: 0.2), widget.gold.withValues(alpha: 0.05)],
                    ),
