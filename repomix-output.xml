                        size: 16,
                        color: isConfirmed ? Colors.greenAccent : (isExpired ? Colors.redAccent : gold),
                      ),
                      const SizedBox(width: 8),
                      Text(
                        isCorrupt 
                            ? 'REGISTRO CORRUPTO / HUÉRFANO' 
                            : (isConfirmed 
                                ? 'CONTRATO FIRMADO' 
                                : (isExpired ? 'PLAZO VENCIDO' : _formatRemaining(remaining))),
                        style: TextStyle(
                          fontSize: 10,
                          fontWeight: FontWeight.w900,
                          letterSpacing: 1,
