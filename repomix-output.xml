      numeroMesa: numeroMesa ?? this.numeroMesa,
      telefono: telefono ?? this.telefono,
      porcentajeDescuento: porcentajeDescuento ?? this.porcentajeDescuento,
      createdAt: createdAt ?? this.createdAt,
    );
  }
}
