                        ],
                      ),
                    ],
                  ),
                  const SizedBox(height: 16),
                  
                  // Detalle de servicios (resumen)
                  Wrap(
                    spacing: 8,
                    runSpacing: 8,
                    children: p.servicios.take(3).map((s) => Container(
