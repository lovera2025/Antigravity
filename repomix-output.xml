                opacity: (_goldBloom.value * 0.42).clamp(0.0, 1.0),
                child: Container(
                  decoration: const BoxDecoration(
                    gradient: RadialGradient(
                      center: Alignment.center,
                      radius: 1.1,
                      colors: [_gold, Colors.transparent],
                      stops: [0.0, 1.0],
