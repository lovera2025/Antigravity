# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Instalador Windows (Inno Setup) — no versionar binarios comprimidos
installer/dist/*
!installer/dist/.gitkeep

# Dump local del repo (opcional)
repomix-output.xml

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
.vercel
.env*.local

# Instaladores viejos guardados a mano: 1 GB que GitHub rechaza (tope 100 MB por
# archivo). Los releases publicados viven en GitHub Releases, no acá.
releases/

# Restos de rescates de archivos y capturas sueltas
*.bak
flutter_*.png

# Scripts de auditoría de un solo uso (tool/_tmp_*): se escriben para mirar un
# caso puntual y quedan tirados sin compilar.
tool/_tmp_*
